@charset "utf-8";

:root {
  color-scheme: light;
  --paper: #f3f1ea;
  --paper-deep: #e8e4d9;
  --ink: #1b211e;
  --ink-soft: #4c5550;
  --muted: #737973;
  --line: #d6d3c9;
  --forest: #203a32;
  --forest-deep: #172923;
  --accent: #d66b43;
  --accent-ink: #341c13;
  --white: #fffefa;
  --header-height: 72px;
  --content-width: 1280px;
  --radius-lg: 28px;
  --radius-md: 18px;
  font-family: Inter, "Aptos", "Segoe UI", system-ui, sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

*,
*::before,
*::after { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--header-height) + 20px);
  background: var(--paper);
}

body {
  min-width: 320px;
  margin: 0;
  overflow-x: hidden;
  background: var(--paper);
  color: var(--ink);
  font-size: 16px;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

body.menu-open { overflow: hidden; }

a { color: inherit; text-decoration: none; }
button { color: inherit; font: inherit; }
img, svg { display: block; max-width: 100%; }
img { height: auto; }

::selection { background: var(--accent); color: var(--accent-ink); }

:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 4px;
}

.skip-link {
  position: fixed;
  z-index: 200;
  top: 8px;
  left: 8px;
  padding: 12px 16px;
  transform: translateY(-160%);
  border-radius: 8px;
  background: var(--ink);
  color: var(--white);
}
.skip-link:focus { transform: translateY(0); }

.container { width: min(calc(100% - 48px), var(--content-width)); margin-inline: auto; }
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 16px;
  color: var(--muted);
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .14em;
  line-height: 1.2;
  text-transform: uppercase;
}
.eyebrow::before { width: 20px; height: 1px; background: var(--accent); content: ""; }

.site-header {
  position: sticky;
  z-index: 100;
  top: 0;
  min-height: var(--header-height);
  border-bottom: 1px solid rgba(27, 33, 30, .1);
  background: rgba(243, 241, 234, .96);
  backdrop-filter: blur(14px);
}
.site-header__inner {
  display: flex;
  width: min(calc(100% - 48px), 1440px);
  min-height: var(--header-height);
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-inline: auto;
}
.brand-logo {
  display: block;
  flex: 0 0 auto;
  width: 170px;
  height: 60px;
  overflow: hidden;
  background-color: #fff;
  background-image: url("../../public/assets/source/ui/background-home.jpg");
  background-repeat: no-repeat;
  background-position: -490px -20px;
  background-size: 1920px 1405px;
}
.header-actions { display: flex; align-items: center; gap: 8px; }
.header-phone,
.menu-toggle {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  gap: 9px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: transparent;
  font-size: .88rem;
  font-weight: 700;
  line-height: 1;
  transition: background-color .18s ease, border-color .18s ease, color .18s ease;
}
.header-phone { padding: 0 17px; background: var(--forest); border-color: var(--forest); color: var(--white); }
.header-phone:hover { background: var(--forest-deep); border-color: var(--forest-deep); }
.header-phone svg { width: 17px; height: 17px; }
.menu-toggle { min-width: 48px; padding: 0 16px; cursor: pointer; }
.menu-toggle:hover { background: var(--paper-deep); }
.menu-toggle__icon { display: grid; gap: 4px; width: 16px; }
.menu-toggle__icon span { width: 16px; height: 1.5px; background: currentColor; transition: transform .2s ease; }
.menu-toggle[aria-expanded="true"] .menu-toggle__icon span:first-child { transform: translateY(2.75px) rotate(45deg); }
.menu-toggle[aria-expanded="true"] .menu-toggle__icon span:last-child { transform: translateY(-2.75px) rotate(-45deg); }

.menu-panel[hidden] { display: none; }
.menu-panel {
  position: fixed;
  z-index: 99;
  inset: var(--header-height) 0 0;
  overflow-y: auto;
  background: var(--forest-deep);
  color: var(--white);
  animation: menu-in .22s ease-out both;
}
.menu-panel__inner {
  display: grid;
  width: min(calc(100% - 48px), 900px);
  min-height: 100%;
  align-content: center;
  gap: 9px;
  margin-inline: auto;
  padding-block: 40px 56px;
}
.menu-panel__link {
  display: flex;
  min-height: 58px;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid rgba(255,255,255,.2);
  font-size: clamp(1.4rem, 4vw, 2.4rem);
  letter-spacing: -.04em;
}
.menu-panel__link::after { color: var(--accent); content: "↗"; font-size: .75em; }
.menu-panel__contact { display: flex; flex-wrap: wrap; gap: 10px 26px; padding-top: 22px; color: rgba(255,255,255,.72); }
.menu-panel__contact a { text-decoration: underline; text-underline-offset: 4px; }
@keyframes menu-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

main { display: block; }
.home-hero { padding: clamp(30px, 4.6vw, 58px) 0 24px; }
.home-hero__inner { display: flex; align-items: center; }
.home-intro { max-width: 940px; }
.home-intro__place { display: flex; align-items: center; gap: 8px; margin: 0 0 17px; color: var(--muted); font-size: .76rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.home-intro__place::before { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); content: ""; }
h1, h2, h3, p { margin-top: 0; }
.home-intro h1,
.page-heading h1 {
  max-width: 19ch;
  margin: 0;
  font-size: clamp(2.75rem, 5.5vw, 5.7rem);
  font-weight: 650;
  letter-spacing: -.07em;
  line-height: .91;
}
.home-intro__text { max-width: 54ch; margin: 17px 0 18px; color: var(--ink-soft); font-size: clamp(.96rem, 1.2vw, 1.08rem); line-height: 1.5; }
.button {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 0 20px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: .88rem;
  font-weight: 750;
  line-height: 1.1;
  transition: transform .18s ease, background-color .18s ease, border-color .18s ease;
}
.button:hover { transform: translateY(-2px); }
.button--dark { background: var(--forest); color: var(--white); }
.button--dark:hover { background: var(--forest-deep); }
.button--light { border-color: var(--line); background: transparent; }
.button--light:hover { background: var(--paper-deep); }
.button--accent { background: var(--accent); color: var(--accent-ink); }
.button--accent:hover { background: #e17a53; }
.button svg { width: 17px; height: 17px; flex: 0 0 auto; }

.directory { padding: 23px 0 0; }
.directory + .directory { margin-top: 22px; border-top: 1px solid var(--line); }
.directory__heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 8px; }
.directory__heading h2 { margin: 0; font-size: .72rem; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
.directory__heading a { color: var(--muted); font-size: .76rem; text-decoration: underline; text-underline-offset: 3px; }
.directory-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 22px; margin: 0; padding: 0; list-style: none; }
.directory-list a {
  display: flex;
  min-height: 42px;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border-bottom: 1px solid var(--line);
  font-size: .89rem;
  font-weight: 600;
  line-height: 1.18;
  transition: color .16s ease;
}
.directory-list a::after { flex: 0 0 auto; color: var(--accent); content: "↗"; font-size: .9rem; }
.directory-list a:hover { color: var(--forest); }
.home-offer { padding: 0 0 clamp(40px, 6vw, 70px); border-bottom: 1px solid var(--line); }
.home-offer__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); gap: clamp(24px, 4vw, 60px); }
.home-offer__grid .directory { padding-top: 16px; }
.home-offer__grid .directory + .directory { margin: 0; padding-left: clamp(20px, 3vw, 42px); border-top: 0; border-left: 1px solid var(--line); }

.section { padding: clamp(56px, 8vw, 110px) 0; }
.section--dark { background: var(--forest-deep); color: var(--white); }
.section--soft { background: var(--paper-deep); }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: clamp(26px, 4vw, 48px); }
.section-heading h2 { max-width: 13ch; margin: 0; font-size: clamp(2.2rem, 4.8vw, 4.5rem); font-weight: 650; letter-spacing: -.065em; line-height: .95; }
.section-heading p { max-width: 42ch; margin: 0; color: var(--ink-soft); }
.section--dark .section-heading p { color: rgba(255,255,255,.68); }

.reviews { overflow: hidden; }
.reviews__top { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
.reviews__source { color: inherit; font-size: .86rem; text-decoration: underline; text-underline-offset: 4px; }
.reviews__track { display: flex; gap: 14px; overflow-x: auto; margin: 26px 0 0; padding: 4px 0 12px; scroll-snap-type: x mandatory; scrollbar-width: thin; scrollbar-color: rgba(255,255,255,.3) transparent; overscroll-behavior-inline: contain; }
.reviews__track::-webkit-scrollbar { height: 5px; }
.reviews__track::-webkit-scrollbar-thumb { border-radius: 4px; background: rgba(255,255,255,.35); }
.review-card { display: flex; flex: 0 0 min(370px, 82vw); min-height: 220px; flex-direction: column; padding: 24px; scroll-snap-align: start; border: 1px solid rgba(255,255,255,.18); border-radius: var(--radius-md); background: rgba(255,255,255,.045); }
.review-card__rating { color: #f2b35f; letter-spacing: .14em; font-size: .86rem; }
.review-card blockquote { display: -webkit-box; overflow: hidden; margin: 15px 0 20px; -webkit-box-orient: vertical; -webkit-line-clamp: 5; font-size: 1rem; line-height: 1.5; }
.review-card__author { margin-top: auto; color: rgba(255,255,255,.72); font-size: .84rem; font-weight: 700; }
.review-card__more { align-self: flex-start; margin: 0 0 15px; padding: 0; border: 0; background: transparent; color: var(--white); font-size: .82rem; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
.reviews__controls { display: flex; gap: 8px; margin-top: 18px; }
.reviews__controls button { display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid rgba(255,255,255,.3); border-radius: 50%; background: transparent; color: inherit; font-size: 1.2rem; cursor: pointer; }
.reviews__controls button:disabled { opacity: .35; cursor: default; }

.split-feature { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(28px, 6vw, 90px); }
.split-feature__image { overflow: hidden; border-radius: var(--radius-lg); background: var(--paper-deep); }
.split-feature__image img { width: 100%; height: 100%; max-height: 500px; object-fit: cover; }
.split-feature h2 { max-width: 11ch; margin: 0 0 16px; font-size: clamp(2.25rem, 4.6vw, 4.25rem); font-weight: 650; letter-spacing: -.065em; line-height: .95; }
.split-feature p { max-width: 48ch; color: var(--ink-soft); }
.split-feature .button { margin-top: 8px; }

.page-main { min-height: 60vh; padding: clamp(36px, 5vw, 68px) 0 clamp(72px, 9vw, 120px); }
.breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 30px; color: var(--muted); font-size: .8rem; }
.breadcrumbs a { text-decoration: underline; text-underline-offset: 3px; }
.breadcrumbs span[aria-current="page"] { color: var(--ink); }
.page-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .55fr); align-items: end; gap: 28px; padding-bottom: 36px; border-bottom: 1px solid var(--line); }
.page-heading h1 { font-size: clamp(2.7rem, 6.5vw, 6rem); }
.page-heading__lead { max-width: 50ch; margin: 0; color: var(--ink-soft); font-size: clamp(1rem, 1.35vw, 1.18rem); }
.page-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }

.content-layout { display: grid; grid-template-columns: minmax(170px, .34fr) minmax(0, 1fr); gap: clamp(28px, 6vw, 88px); align-items: start; margin-top: 38px; }
.toc { position: sticky; top: calc(var(--header-height) + 20px); }
.toc__title { margin: 0 0 10px; color: var(--muted); font-size: .7rem; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
.toc__list { display: grid; margin: 0; padding: 0; list-style: none; }
.toc__list a { display: block; padding: 9px 0; border-bottom: 1px solid var(--line); color: var(--ink-soft); font-size: .85rem; line-height: 1.3; }
.toc__list a:hover, .toc__list a[aria-current="location"] { color: var(--ink); }
.toc-mobile { display: none; }

.article-copy { max-width: 850px; }
.article-copy > :first-child { margin-top: 0; }
.article-copy p { max-width: 72ch; margin: 0 0 1.1em; color: var(--ink-soft); line-height: 1.68; }
.article-copy h2,
.article-copy h3 { margin: 1.8em 0 .65em; font-weight: 650; letter-spacing: -.045em; line-height: 1.05; }
.article-copy h2 { font-size: clamp(1.7rem, 3.2vw, 2.6rem); }
.article-copy h3 { font-size: clamp(1.25rem, 2.4vw, 1.7rem); }
.article-copy ul,
.article-copy ol { margin: 0 0 1.3em; padding-left: 1.25em; color: var(--ink-soft); }
.article-copy li { margin: .42em 0; padding-left: .22em; }
.article-copy strong { color: var(--ink); }
.article-copy a { color: var(--forest); text-decoration: underline; text-underline-offset: 3px; }

.accordion-list { display: grid; gap: 10px; }
.accordion-item { overflow: clip; border: 1px solid var(--line); border-radius: 16px; background: rgba(255,255,255,.28); }
.accordion-trigger { display: flex; width: 100%; min-height: 64px; align-items: center; justify-content: space-between; gap: 18px; padding: 14px 18px; border: 0; background: transparent; text-align: left; font-size: 1rem; font-weight: 700; cursor: pointer; }
.accordion-trigger { list-style: none; }
.accordion-trigger::-webkit-details-marker { display: none; }
.accordion-trigger__label { flex: 1 1 auto; }
.accordion-trigger:hover { background: rgba(255,255,255,.42); }
.accordion-trigger__icon { display: grid; width: 32px; height: 32px; flex: 0 0 auto; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--forest); }
.accordion-trigger__icon::before { content: "+"; font-size: 1.25rem; line-height: 1; }
.accordion-item[open] > .accordion-trigger .accordion-trigger__icon::before,
.accordion-trigger[aria-expanded="true"] .accordion-trigger__icon::before { content: "−"; }
.accordion-panel { padding: 0 18px 20px; }
.accordion-panel[hidden] { display: none; }
.accordion-panel > :first-child { margin-top: 0; }
.accordion-panel > :last-child { margin-bottom: 0; }
.detail-gallery-link { display: inline-flex; min-height: 44px; align-items: center; gap: 9px; margin-top: 24px; color: var(--forest); font-weight: 750; text-decoration: underline; text-underline-offset: 4px; }
.detail-gallery-link::after { color: var(--accent); content: "↗"; }
.detail-pagination { display: flex; justify-content: space-between; gap: 14px; margin-top: 44px; padding-top: 18px; border-top: 1px solid var(--line); }
.detail-pagination a { display: flex; max-width: 48%; flex-direction: column; gap: 4px; font-weight: 700; }
.detail-pagination small { color: var(--muted); font-size: .7rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
.detail-pagination a:last-child { text-align: right; }

.category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-top: 34px; }
.category-link { display: flex; min-height: 100px; align-items: flex-end; justify-content: space-between; gap: 14px; padding: 17px; border: 1px solid var(--line); border-radius: 14px; background: rgba(255,255,255,.3); font-size: 1rem; font-weight: 700; line-height: 1.15; transition: background .18s ease, border-color .18s ease, transform .18s ease; }
.category-link::after { flex: 0 0 auto; color: var(--accent); content: "↗"; }
.category-link:hover { transform: translateY(-2px); border-color: var(--forest); background: var(--white); }
.service-card__summary { display: block; margin-top: 8px; color: var(--muted); font-size: .8rem; font-weight: 450; line-height: 1.35; }

.gallery-toolbar { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 22px; }
.gallery-filter { display: inline-flex; min-height: 42px; align-items: center; padding: 0 15px; border: 1px solid var(--line); border-radius: 999px; background: transparent; font-size: .82rem; font-weight: 650; cursor: pointer; }
.gallery-filter[aria-pressed="true"], .gallery-filter:hover { border-color: var(--forest); background: var(--forest); color: var(--white); }
.gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.gallery-card { min-width: 0; overflow: hidden; border-radius: 14px; background: var(--paper-deep); }
.gallery-card[hidden] { display: none; }
.gallery-card__image { overflow: hidden; aspect-ratio: 4 / 3; background: #e5e2d9; }
.gallery-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s cubic-bezier(.2,.75,.3,1); }
.gallery-card:hover .gallery-card__image img { transform: scale(1.025); }
.gallery-card figcaption { padding: 11px 13px 13px; color: var(--ink-soft); font-size: .8rem; line-height: 1.4; }
.gallery-back { margin: 0 0 24px; }

.review-modal[hidden] { display: none; }
.review-modal { position: fixed; z-index: 160; inset: 0; display: grid; place-items: center; padding: 20px; background: rgba(13,20,17,.7); }
.review-modal__dialog { width: min(100%, 650px); max-height: min(80svh, 700px); overflow: auto; padding: 28px; border-radius: 20px; background: var(--paper); box-shadow: 0 20px 80px rgba(0,0,0,.28); }
.review-modal__close { float: right; display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: transparent; font-size: 1.4rem; cursor: pointer; }
.review-modal blockquote { margin: 18px 0; line-height: 1.65; }

.partner-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.partner-logo { display: grid; min-height: 74px; min-width: 125px; flex: 1 1 125px; place-items: center; padding: 12px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--white); }
.partner-logo img { max-width: 130px; max-height: 48px; object-fit: contain; }

.location-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 30px; }
.location-card { overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: rgba(255,255,255,.32); }
.location-card__photo { aspect-ratio: 16 / 10; overflow: hidden; background: var(--paper-deep); }
.location-card__photo img { width: 100%; height: 100%; object-fit: cover; }
.location-card__body { padding: 17px; }
.location-card h2 { margin: 0 0 8px; font-size: 1.15rem; letter-spacing: -.03em; }
.location-card address { color: var(--ink-soft); font-size: .9rem; font-style: normal; }
.location-card__links { display: grid; gap: 7px; margin-top: 13px; }
.location-card__links a { width: fit-content; font-size: .88rem; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.location-card__hours { margin-top: 12px; color: var(--muted); font-size: .82rem; }

.contact-section-title { margin: 32px 0 14px; font-size: .72rem; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
.contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.contact-card { min-width: 0; padding: 20px; border: 1px solid var(--line); border-radius: 16px; background: rgba(255,255,255,.32); }
.contact-card h2 { margin: 0 0 10px; font-size: 1.1rem; letter-spacing: -.025em; }
.contact-card p { margin: 0 0 8px; color: var(--ink-soft); font-size: .9rem; line-height: 1.5; }
.contact-card p:last-child { margin-bottom: 0; }
.contact-card a { color: var(--forest); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
.contact-card--wide { grid-column: 1 / -1; }
.source-note { margin: 14px 0 0; color: var(--muted); font-size: .8rem; }

.site-footer { padding: 30px 0; background: var(--forest-deep); color: var(--white); }
.site-footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px 30px; }
.site-footer__nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
.site-footer a { font-size: .84rem; text-decoration: underline; text-underline-offset: 3px; }
.site-footer__copy { color: rgba(255,255,255,.65); font-size: .76rem; }

.not-found { min-height: 55vh; display: grid; align-content: center; padding-block: 60px; }
.not-found h1 { margin: 0 0 12px; font-size: clamp(2rem, 5vw, 4rem); letter-spacing: -.06em; }

@media (max-width: 900px) {
  .home-intro h1 { font-size: clamp(2.65rem, 6.3vw, 4.6rem); }
  .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .location-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 700px) {
  :root { --header-height: 64px; }
  .container, .site-header__inner { width: calc(100% - 32px); }
  .site-header__inner { gap: 8px; }
  .brand-logo { width: 116px; height: 44px; background-position: -490px -20px; transform: scale(.78); transform-origin: left center; margin-right: -24px; }
  .header-actions { gap: 6px; }
  .header-phone { width: auto; min-width: 100px; padding: 0 11px; gap: 6px; font-size: .72rem; }
  .header-phone__text { position: static; width: auto; height: auto; overflow: visible; clip: auto; white-space: nowrap; }
  .menu-toggle { min-width: 44px; padding: 0 12px; font-size: .76rem; }
  .menu-panel__inner { width: calc(100% - 40px); gap: 4px; }
  .menu-panel__link { min-height: 52px; font-size: clamp(1.35rem, 6vw, 2rem); }
  .home-hero { padding: 21px 0 16px; }
  .home-intro { max-width: 100%; }
  .home-intro__place { margin-bottom: 9px; font-size: .67rem; }
  .home-intro h1 { max-width: 17ch; font-size: clamp(2.35rem, 9.3vw, 3.2rem); }
  .home-intro__text { max-width: 48ch; margin: 10px 0 13px; font-size: .89rem; }
  .home-intro .button { min-height: 44px; padding-inline: 17px; font-size: .82rem; }
  .home-offer { padding-bottom: 28px; }
  .home-offer__grid { display: block; }
  .home-offer__grid .directory { padding-top: 14px; }
  .home-offer__grid .directory + .directory { margin-top: 12px; padding-top: 14px; padding-left: 0; border-top: 1px solid var(--line); border-left: 0; }
  .directory { padding-top: 18px; }
  .directory + .directory { margin-top: 15px; }
  .directory__heading { margin-bottom: 3px; }
  .directory__heading h2 { font-size: .68rem; }
  .directory__heading a { font-size: .72rem; }
  .directory-list { gap: 0 12px; }
  .directory-list a { min-height: 39px; font-size: .8rem; }
  .section { padding: 54px 0; }
  .section-heading, .reviews__top { display: block; }
  .section-heading h2 { font-size: clamp(2.15rem, 10vw, 3.5rem); }
  .section-heading p { margin-top: 14px; font-size: .92rem; }
  .reviews__source { display: inline-block; margin-top: 14px; }
  .reviews__track { margin-top: 20px; gap: 10px; }
  .review-card { flex-basis: 84%; min-height: 208px; padding: 19px; }
  .reviews__controls button { width: 44px; height: 44px; }
  .split-feature { grid-template-columns: 1fr; gap: 24px; }
  .split-feature__image { order: 2; border-radius: 18px; }
  .split-feature__image img { max-height: 290px; }
  .split-feature h2 { font-size: clamp(2.1rem, 9.5vw, 3.35rem); }
  .page-main { padding: 25px 0 68px; }
  .breadcrumbs { margin-bottom: 22px; font-size: .74rem; }
  .page-heading { display: block; padding-bottom: 24px; }
  .page-heading h1 { font-size: clamp(2.55rem, 11vw, 4rem); }
  .page-heading__lead { margin-top: 15px; font-size: .94rem; }
  .page-actions { margin-top: 16px; }
  .content-layout { display: block; margin-top: 22px; }
  .toc { display: none; }
  .toc-mobile { display: block; margin: 0 0 16px; }
  .toc-mobile summary { display: flex; min-height: 46px; align-items: center; justify-content: space-between; padding: 0 14px; border: 1px solid var(--line); border-radius: 12px; background: rgba(255,255,255,.35); font-size: .86rem; font-weight: 700; cursor: pointer; list-style: none; }
  .toc-mobile summary::-webkit-details-marker { display: none; }
  .toc-mobile summary::after { content: "+"; color: var(--accent); font-size: 1.2rem; }
  .toc-mobile[open] summary::after { content: "−"; }
  .toc-mobile .toc__list { padding: 5px 13px 12px; }
  .toc-mobile .toc__list a { min-height: 40px; }
  .article-copy p { font-size: .94rem; line-height: 1.62; }
  .article-copy h2 { margin-top: 1.45em; font-size: 1.65rem; }
  .accordion-list { gap: 8px; }
  .accordion-trigger { min-height: 58px; padding: 12px 13px; font-size: .94rem; }
  .accordion-panel { padding: 0 14px 16px; }
  .category-grid { gap: 8px; margin-top: 22px; }
  .category-link { min-height: 90px; padding: 12px; font-size: .88rem; }
  .service-card__summary { font-size: .75rem; }
  .gallery-toolbar { flex-wrap: nowrap; overflow-x: auto; margin: 20px -16px 16px; padding: 2px 16px 7px; scrollbar-width: none; }
  .gallery-toolbar::-webkit-scrollbar { display: none; }
  .gallery-filter { flex: 0 0 auto; min-height: 40px; padding-inline: 13px; }
  .gallery-grid { grid-template-columns: 1fr; gap: 10px; }
  .gallery-card__image { aspect-ratio: 16 / 10; }
  .gallery-card figcaption { padding: 10px 12px 12px; }
  .detail-gallery-link { margin-top: 18px; }
  .detail-pagination { margin-top: 32px; }
  .location-grid { grid-template-columns: 1fr; gap: 10px; }
  .contact-grid { grid-template-columns: 1fr; gap: 9px; }
  .contact-card { padding: 16px; }
  .location-card { border-radius: 14px; }
  .site-footer__inner { display: block; }
  .site-footer__nav { gap: 9px 16px; margin-bottom: 14px; }
}

@media (max-width: 360px) {
  .container, .site-header__inner { width: calc(100% - 26px); }
  .home-intro h1 { font-size: 2.2rem; }
  .directory-list { gap: 0 8px; }
  .directory-list a { font-size: .76rem; }
  .header-phone { min-width: 96px; }
  .header-phone { padding-inline: 8px; gap: 4px; font-size: .68rem; }
  .header-phone svg { width: 15px; height: 15px; }
  .menu-toggle { min-width: 68px; width: auto; padding-inline: 9px; gap: 6px; font-size: .7rem; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
